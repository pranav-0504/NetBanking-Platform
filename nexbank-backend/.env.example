# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexbank?retryWrites=true&w=majority

# Redis — set REDIS_ENABLED=true when Redis is installed/running
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# PostgreSQL (audit logs — Phase 4)
POSTGRES_URI=postgresql://postgres:password@localhost:5432/nexbank_audit

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=20m
JWT_REFRESH_EXPIRY=7d

# CORS
CLIENT_URL=http://localhost:4200
